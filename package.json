{
  "name": "gemini-translate",
  "version": "1.0.0",
  "description": "DSH plugin: translate Chinese composer text to English with Gemini, then send it to the current model.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "gemini",
    "translation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoozlmaki-byte/dsh-gemini-translate.git"
  },
  "bugs": {
    "url": "https://github.com/zoozlmaki-byte/dsh-gemini-translate/issues"
  },
  "homepage": "https://github.com/zoozlmaki-byte/dsh-gemini-translate#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-credentials": "*"
  }
}
